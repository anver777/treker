# ============================================================
# LIFE RPG — environment variables
# Copy this file to `.env.local` (never commit real keys).
# ============================================================

# AI Coach (optional). Without a key the app still works — the coach
# falls back to the on-device analyst that reads your local data.
# Any OpenAI-compatible chat completions endpoint works.
VITE_AI_API_KEY=
VITE_AI_API_URL=https://api.openai.com/v1/chat/completions
VITE_AI_MODEL=gpt-4o-mini
